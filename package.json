  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.38.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
