{
  "name": "@sendrin/sdk",
  "version": "0.1.0",
  "description": "Official Node.js/TypeScript SDK for the Sendrin notification API",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {".": {"import": "./dist/index.js", "types": "./dist/index.d.ts"}},
  "scripts": {
    "generate-types": "openapi-typescript ../../apps/docs/content/openapi.json -o src/generated/openapi-types.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.1"
  }
}
